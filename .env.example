# Vorlage für die lokale Konfiguration.
# Kopieren nach .env.local und Werte eintragen (.env.local wird nicht eingecheckt).
# Nur öffentliche Client-Werte: Projekt-URL und Publishable Key, niemals den Service-Role-Key.
#
# Lokale Supabase-Instanz: Werte aus `supabase status` übernehmen.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
